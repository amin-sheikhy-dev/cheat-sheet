{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Amoled Dark Shiny",
  "author": "Ported from VS Code",

  "themes": [
    {
      "name": "Amoled Dark Shiny",
      "appearance": "dark",
      "style": {
        "border": "#343434",
        "border.variant": "#343434",
        "border.focused": "#6CC7F6",
        "border.selected": "#6CC7F6",
        "border.transparent": "#00000000",
        "border.disabled": "#242424",

        "background": "#0e0e0e",
        "surface.background": "#0e0e0e",
        "elevated_surface.background": "#0e0e0e",
        "panel.background": "#0e0e0e",
        "panel.focused_border": "#6CC7F6",
        "drop_target.background": "#3793E01a",

        "element.background": "#0e0e0e",
        "element.hover": "#343434",
        "element.active": "#343434",
        "element.selected": "#343434",
        "element.disabled": "#0e0e0e",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#343434",
        "ghost_element.active": "#343434",
        "ghost_element.selected": "#343434",
        "ghost_element.disabled": "#00000000",

        "text": "#e6e6e6",
        "text.muted": "#ffffff",
        "text.placeholder": "#757575",
        "text.disabled": "#535353",
        "text.accent": "#6CC7F6",

        "icon": "#e6e6e6",
        "icon.muted": "#999999",
        "icon.disabled": "#535353",
        "icon.placeholder": "#757575",
        "icon.accent": "#6CC7F6",

        "status_bar.background": "#343434",
        "title_bar.background": "#0e0e0e",
        "title_bar.inactive_background": "#0e0e0e",
        "toolbar.background": "#0e0e0e",
        "tab_bar.background": "#0e0e0e",
        "tab.inactive_background": "#0e0e0e",
        "tab.active_background": "#0e0e0e",
        "search.match_background": "#6CC7F666",

        "scrollbar.thumb.background": "#ffffff33",
        "scrollbar.thumb.hover_background": "#ffffff55",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#0e0e0e",
        "scrollbar.track.border": "#343434",

        "editor.foreground": "#999999",
        "editor.background": "#0e0e0e",
        "editor.gutter.background": "#0e0e0e",
        "editor.subheader.background": "#0e0e0e",
        "editor.active_line.background": "#000000",
        "editor.highlighted_line.background": "#343434",
        "editor.line_number": "#343434",
        "editor.active_line_number": "#757575",
        "editor.invisible": "#242424",
        "editor.wrap_guide": "#242424",
        "editor.active_wrap_guide": "#343434",
        "editor.document_highlight.read_background": "#00000000",
        "editor.document_highlight.write_background": "#00000000",

        "terminal.background": "#0e0e0e",
        "terminal.foreground": "#ffffff",
        "terminal.bright_foreground": "#ffffff",
        "terminal.dim_foreground": "#999999",
        "terminal.ansi.black": "#343434",
        "terminal.ansi.bright_black": "#535BCF",
        "terminal.ansi.dim_black": "#242424",
        "terminal.ansi.red": "#E1270E",
        "terminal.ansi.bright_red": "#E1270E",
        "terminal.ansi.dim_red": "#9a1b0a",
        "terminal.ansi.green": "#5BC266",
        "terminal.ansi.bright_green": "#5BC266",
        "terminal.ansi.dim_green": "#3f8747",
        "terminal.ansi.yellow": "#FBCC43",
        "terminal.ansi.bright_yellow": "#FBCC43",
        "terminal.ansi.dim_yellow": "#b0902f",
        "terminal.ansi.blue": "#535BCF",
        "terminal.ansi.bright_blue": "#6f77e6",
        "terminal.ansi.dim_blue": "#3a408f",
        "terminal.ansi.magenta": "#BF5AF2",
        "terminal.ansi.bright_magenta": "#d27df7",
        "terminal.ansi.dim_magenta": "#8a3fae",
        "terminal.ansi.cyan": "#6CC7F6",
        "terminal.ansi.bright_cyan": "#8fd6f9",
        "terminal.ansi.dim_cyan": "#4b8bac",
        "terminal.ansi.white": "#ffffff",
        "terminal.ansi.bright_white": "#ffffff",
        "terminal.ansi.dim_white": "#999999",

        "link_text.hover": "#28A9FF",

        "conflict": "#FBCC43",
        "conflict.background": "#FBCC4322",
        "conflict.border": "#FBCC43",
        "created": "#5BC266",
        "created.background": "#5BC26622",
        "created.border": "#5BC266",
        "deleted": "#E1270E",
        "deleted.background": "#E1270E22",
        "deleted.border": "#E1270E",
        "error": "#E1270E",
        "error.background": "#E1270E22",
        "error.border": "#E1270E",
        "hidden": "#757575",
        "hidden.background": "#0e0e0e",
        "hidden.border": "#343434",
        "hint": "#6CC7F6",
        "hint.background": "#6CC7F622",
        "hint.border": "#6CC7F6",
        "ignored": "#757575",
        "ignored.background": "#0e0e0e",
        "ignored.border": "#343434",
        "info": "#6CC7F6",
        "info.background": "#6CC7F622",
        "info.border": "#6CC7F6",
        "modified": "#FBCC43",
        "modified.background": "#FBCC4322",
        "modified.border": "#FBCC43",
        "predictive": "#757575",
        "predictive.background": "#0e0e0e",
        "predictive.border": "#343434",
        "renamed": "#BF5AF2",
        "renamed.background": "#BF5AF222",
        "renamed.border": "#BF5AF2",
        "success": "#5BC266",
        "success.background": "#5BC26622",
        "success.border": "#5BC266",
        "unreachable": "#757575",
        "unreachable.background": "#0e0e0e",
        "unreachable.border": "#343434",
        "warning": "#FBCC43",
        "warning.background": "#FBCC4322",
        "warning.border": "#FBCC43",

        "players": [
          {
            "cursor": "#ffffff",
            "background": "#ffffff",
            "selection": "#3793E033"
          },
          {
            "cursor": "#BF5AF2",
            "background": "#BF5AF2",
            "selection": "#BF5AF233"
          },
          {
            "cursor": "#FF7135",
            "background": "#FF7135",
            "selection": "#FF713533"
          },
          {
            "cursor": "#42DD76",
            "background": "#42DD76",
            "selection": "#42DD7633"
          },
          {
            "cursor": "#FFB638",
            "background": "#FFB638",
            "selection": "#FFB63833"
          }
        ],

        "syntax": {
          "attribute": { "color": "#FFB638", "font_style": "italic" },
          "boolean": { "color": "#D62C2C" },
          "comment": { "color": "#6160a4aa", "font_style": "italic" },
          "comment.doc": { "color": "#6160a4aa", "font_style": "italic" },
          "constant": { "color": "#D62C2C" },
          "constructor": { "color": "#14E5D4", "font_style": "italic" },
          "embedded": { "color": "#eeeeee" },
          "emphasis": { "color": "#28A9FF", "font_style": "italic" },
          "emphasis.strong": { "color": "#28A9FF", "font_weight": 700 },
          "enum": { "color": "#A95EFF" },
          "function": { "color": "#28A9FF" },
          "hint": { "color": "#6CC7F6" },
          "keyword": { "color": "#FFB638" },
          "label": { "color": "#FFB638" },
          "link_text": { "color": "#28A9FF" },
          "link_uri": { "color": "#28A9FF" },
          "number": { "color": "#FF7135" },
          "operator": { "color": "#FFB638" },
          "predictive": { "color": "#757575" },
          "preproc": { "color": "#FFB638" },
          "primary": { "color": "#eeeeee" },
          "property": { "color": "#eeeeee" },
          "punctuation": { "color": "#6160a4" },
          "punctuation.bracket": { "color": "#6160a4" },
          "punctuation.delimiter": { "color": "#6160a4" },
          "punctuation.list_marker": { "color": "#28A9FF" },
          "punctuation.special": { "color": "#8584e3" },
          "string": { "color": "#42DD76" },
          "string.escape": { "color": "#14E5D4" },
          "string.regex": { "color": "#42DD76" },
          "string.special": { "color": "#42DD76" },
          "string.special.symbol": { "color": "#42DD76" },
          "tag": { "color": "#28A9FF" },
          "text.literal": { "color": "#A95EFF" },
          "title": { "color": "#FFB638", "font_weight": 700 },
          "type": { "color": "#A95EFF" },
          "variable": { "color": "#FF478D" },
          "variable.special": { "color": "#FF7135", "font_style": "italic" },
          "variant": { "color": "#A95EFF" }
        }
      }
    }
  ]
}
